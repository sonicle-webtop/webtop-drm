  "paths": {
    "/timetable": {
      "get": {
        "summary": "List Timetable Entries",
        "operationId": "listTimetableEntries",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TimetableEntriesResult"
                }
              }
            }
          }
        },
        "description": "List timetable entries for a specific month / year",
        "parameters": [
          {
            "schema": {
              "type": "string"
            },
            "in": "query",
            "name": "operatorId",
            "description": "Effective user"
          },
          {
            "schema": {
              "type": "integer"
            },
            "in": "query",
            "name": "year"
          },
          {
            "schema": {
              "type": "integer"
            },
            "in": "query",
            "name": "month"
          }
        ],
        "tags": [
          "me"
        ]
      },
      "post": {
        "summary": "Punch",
        "operationId": "punch",
        "responses": {
          "200": {
            "description": "OK"
          }
        },
        "parameters": [
          {
            "schema": {
              "type": "string"
            },
            "in": "query",
            "name": "type",
            "description": "M = Manual , S = Special"
          },
          {
            "schema": {
              "type": "string"
            },
            "in": "query",
            "name": "location",
            "description": "O = Office, S = Smart, A = App"
          }
        ],
        "description": "Register a Punch (Clock-in / Clock-out automatic)"
      }
    },
    "/leaveRequests": {
      "get": {
        "summary": "List Leave Requests",
        "tags": [],
        "responses": {
          "200": {
            "description": "OK",
