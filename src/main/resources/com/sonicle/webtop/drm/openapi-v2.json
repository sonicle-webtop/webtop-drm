            },
            "in": "query",
            "name": "userId"
          },
          {
            "schema": {
              "type": "string"
            },
            "in": "query",
            "name": "startDate"
          },
          {
            "schema": {
              "type": "integer"
            },
            "in": "query",
            "name": "leaveRequestId"
          }
        ]
      },
      "parameters": [],
      "post": {
        "summary": "Add new Leave Requesst",
        "operationId": "addLeaveRequest",
        "responses": {
          "200": {
            "description": "OK"
          }
        },
        "description": "Add a new Leave Request",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LeaveRequest"
              }
            }
          }
        }
      },
      "put": {
        "summary": "Update Leave Request",
        "operationId": "updateLeaveRequests",
        "responses": {
          "200": {
            "description": "OK"
          }
        },
        "description": "Update Leave Request",
        "parameters": [],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LeaveRequest"
              }
            }
          }
        }
      },
      "delete": {
        "summary": "Delete Leave Request",
        "operationId": "deleteLeaveRequest",
        "responses": {
          "200": {
            "description": "OK"
          }
        },
        "description": "Delete a Leave Request",
        "parameters": [
          {
            "schema": {
              "type": "integer"
            },
            "in": "query",
            "name": "leaveRequestId"
          },
          {
            "schema": {
              "type": "string",
              "enum": [
                "delete",
                "approve",
                "refuse",
                "cancel",
                "requestCancellation"
              ]
            },
            "in": "query",
            "name": "action"
          },
          {
            "schema": {
              "type": "string"
            },
            "in": "query",
            "name": "text"
          }
        ]
      }
    },
